HOST=0.0.0.0
PORT=3000
DATABASE_PATH=.data/lingualeaf.sqlite
DICTIONARY_PATH=.data/dictionary.sqlite

# 译文行(DeepSeek 翻译)。不配置 key 则照常导入,译文行留空。
DEEPSEEK_API_KEY=
# OpenAI 兼容根地址(服务端拼 /chat/completions;不要带 /anthropic)。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 可选:整体替换内置翻译风格提示词(自然意译、学习者友好)。
#DEEPSEEK_TRANSLATION_PROMPT=
