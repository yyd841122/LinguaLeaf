{
  "name": "@lingualeaf/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:sql-locality": "node scripts/check-sql-locality.mjs",
    "check:task-lifecycle": "node scripts/check-task-lifecycle-locality.mjs",
    "dict:import-ecdict": "node --import tsx src/dict/import-ecdict.ts",
    "dict:import-ipa-dict": "node --import tsx src/dict/import-ipa-dict.ts",
    "build:file-script": "node scripts/build-file-script.mjs",
    "build:export-style": "node scripts/build-export-style.mjs"
  },
  "dependencies": {
    "@lingualeaf/reading-model": "0.1.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "markdown-it": "^15.0.3",
    "multer": "^2.4.0",
    "sbd": "^1.0.19",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/multer": "^2.3.0",
    "@types/sbd": "^1.0.5",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "pdf-lib": "^1.17.1",
    "supertest": "^7.1.4",
    "vite": "~7.3.6"
  }
}
