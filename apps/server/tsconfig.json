{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  // contract.test.ts imports apps/web sources, which use Bundler-style
  // extensionless imports NodeNext cannot follow. Vitest resolves them, so
  // the NodeNext project stays out; the file's imports are typechecked by
  // tsconfig.contract-test.json (Bundler resolution), wired into the root
  // typecheck as check:contract-types.
  "exclude": ["test/contract.test.ts"]
}
