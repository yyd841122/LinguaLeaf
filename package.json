{
  "name": "lingualeaf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch apps/server/src/main.ts --dev",
    "build": "npm run typecheck && npm run build --workspace @lingualeaf/web && npm run build --workspace @lingualeaf/server",
    "start": "node --env-file-if-exists=.env .output/server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "~3.2.7"
  }
}
